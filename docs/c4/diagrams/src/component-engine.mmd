---
title: "Component diagram — proof-engine authoring and execution"
---
flowchart TB
    dev["<b>Builder / developer</b><br/><i>«person»</i><br/>Requests scope; answers required gates"]
    subgraph engine["<b>proof-engine</b> — authoring instructions"]
        parser["<b>Resolve request</b><br/>mode · planner · framework · dry-run"]
        mapper["<b>Map phases</b><br/>Applicable lifecycle and human gates"]
        shaper["<b>Choose shape</b><br/>Pipeline; earned barrier; bounded loop"]
        author["<b>Author script</b><br/>Template + task parameters + schemas"]
        preflight["<b>Pre-flight</b><br/>All-out estimate and required answer"]
        routes["<b>ROUTES</b><br/>Canonical source copied byte-identically"]
        reporter["<b>Report evidence</b><br/>Actual checks, results and unknowns"]
    end
    policy["Shared policies<br/>harness · loop · modes"]
    frameworks["AIDLC / VENTURE<br/>phases and gates"]
    wf["<b>Host Workflow</b><br/>Supported and authorized execution"]
    models["<b>Configured models</b><br/>Pins are not account-availability evidence"]
    dev --> parser --> mapper --> shaper --> author
    frameworks -. "phase contract" .-> mapper
    policy -. "shape / bounds" .-> shaper
    author -. "copy source" .-> routes
    author -- "all-out" --> preflight
    preflight -- "estimate / choice" --> dev
    preflight -- "authorized script + args" --> wf
    author -- "lite / balanced within scope" --> wf
    wf -- "evaluates per node" --> routes
    routes -- "agent options" --> models
    wf -- "result + available usage evidence" --> reporter
    reporter -- "deliverable / phase gate" --> dev
    classDef person fill:#164E55,stroke:#102F35,color:#fff
    classDef component fill:#D8F1EE,stroke:#0F766E,color:#102F35
    classDef ext fill:#E7E5E4,stroke:#78716C,color:#1C1917
    class dev person
    class parser,mapper,shaper,author,preflight,routes,reporter component
    class policy,frameworks,wf,models ext
    style engine fill:#F1F9F7,stroke:#8BC8C1
