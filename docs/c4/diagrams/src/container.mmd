        gate["<b>Validation Gate</b><br/><i>«container» Node.js + CI</i><br/>3 scripts; fails the build on any contract breach"]
        packs["<b>Host Packs</b><br/><i>«container» generated — dist/&lt;host&gt;/</i><br/>20 of 24 skills, no templates,<br/>for Cursor · Codex · Antigravity"]
