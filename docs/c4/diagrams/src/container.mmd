        direction TB
        manifest["<b>Plugin Manifests</b><br/><i>«container» JSON — .claude-plugin/</i><br/>How the host discovers and installs the plugin"]
        routers["<b>Skill Routers</b><br/><i>«container» 22 × SKILL.md</i><br/>Thin routers; the description is the selection API"]
        refs["<b>Reference Library</b><br/><i>«container» 121 × Markdown</i><br/>Deep knowledge, loaded on demand;<br/>every skill has a pinned standards.md"]
        templates["<b>Workflow Templates</b><br/><i>«container» 29 × plain JS</i><br/>Executed in a sandbox,<br/>never read into context"]
        policy["<b>Governance Policies</b><br/><i>«container» Markdown</i><br/>Read-only law: harness H1–H12 ·<br/>loop L1–L8 · modes M1–M9"]
        frameworks["<b>Lifecycle Frameworks</b><br/><i>«container» Markdown — AIDLC</i><br/>Phases and the human gates between them"]
