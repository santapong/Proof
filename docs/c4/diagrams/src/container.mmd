---
title: "Container diagram — TheLoopSkill"
---
flowchart TB
    dev["<b>Developer</b><br/><i>«person»</i>"]
    cc["<b>Claude Code</b><br/><i>«external system»</i><br/>Skill discovery, agent loop, Workflow tool"]

    subgraph tls["<b>TheLoopSkill</b> &nbsp;[SYSTEM]"]
        manifest["<b>Plugin Manifests</b><br/><i>«container» JSON — .claude-plugin/</i><br/>How the host discovers and installs the plugin"]
        routers["<b>Skill Routers</b><br/><i>«container» 19 × SKILL.md</i><br/>Thin routers; the description is the selection API"]
        refs["<b>Reference Library</b><br/><i>«container» 93 × Markdown</i><br/>Deep knowledge, loaded on demand;<br/>every skill has a pinned standards.md"]
        templates["<b>Workflow Templates</b><br/><i>«container» 24 × plain JS</i><br/>Executed in a sandbox,<br/>never read into context"]
        policy["<b>Governance Policies</b><br/><i>«container» Markdown</i><br/>Read-only law: harness H1–H12 ·<br/>loop L1–L8 · modes M1–M9"]
        frameworks["<b>Lifecycle Frameworks</b><br/><i>«container» Markdown — AIDLC</i><br/>Phases and the human gates between them"]
        design["<b>Design Records</b><br/><i>«container» docs/design/</i><br/>The boundary audit — normative"]
        gate["<b>Validation Gate</b><br/><i>«container» Node.js + CI</i><br/>Fails the build on any contract breach"]
    end

    fleet["<b>Claude Model Fleet</b><br/><i>«external system»</i><br/>Haiku 4.5 · Sonnet 5 · Opus 5 · Fable 5"]
    repo["<b>Target Repository</b><br/><i>«external system»</i>"]

    dev -- "invokes /loop-*" --> cc
    cc -- "discovers the<br/>plugin from" --> manifest
    cc -- "loads on invocation" --> routers
    routers -- "reads on demand" --> refs
    routers -- "consumes read-only" --> policy
    routers -- "maps task onto phases" --> frameworks
    routers -- "authors a script from" --> templates
    cc -- "executes via the<br/>Workflow tool" --> templates
    templates -- "spawns agents at the<br/>tier ROUTES selects" --> fleet
    fleet -- "reads code;<br/>implement nodes patch" --> repo
    gate -- "validates frontmatter,<br/>names, paths" --> routers
    gate -- "validates H10 + ROUTES<br/>byte-identity" --> templates
    design -- "governs every description<br/>and boundary" --> routers

    classDef person fill:#08427B,stroke:#052E56,color:#fff
    classDef container fill:#438DD5,stroke:#2E6295,color:#fff
    classDef ext fill:#999999,stroke:#6B6B6B,color:#fff
    class dev person
    class manifest,routers,refs,templates,policy,frameworks,design,gate container
    class cc,fleet,repo ext
    style tls fill:none,stroke:#444444,stroke-dasharray:5 5
