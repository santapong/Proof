---
title: "Component diagram — how the twenty-five skills compose"
---
%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 48}, "themeVariables": {"fontFamily": "Segoe UI, Helvetica, Arial, sans-serif", "fontSize": "13px"}}}%%
flowchart TB
    guide(["<b>loop-guide</b><br/><i>the front door</i><br/>interview → verdict → dispatch"])

    subgraph core["<b>Engine &amp; planning</b>"]
        direction TB
        orch("<b>loop-orchestrate</b><br/><i>planning layer</i>")
        build("<b>loop-build</b><br/><i>v1 conductor</i>")
        vent("<b>loop-venture</b><br/><i>venture conductor</i>")
        ctx("<b>loop-context</b><br/><i>agent state</i>")
        mk("<b>loop-skill</b><br/><i>meta</i>")
        eng{{"<b>loop-engine</b><br/><i>orchestration engine</i><br/>pipeline · parallel · loop"}}
    end

    subgraph gov["<b>Governance</b> — read-only law"]
        direction TB
        pol[["<b>Engineering policies</b><br/><i>harness H1–H12 · loop L1–L8 · modes M1–M9</i>"]]
        fw[["<b>Lifecycle frameworks</b><br/><i>AIDLC · VENTURE — phases and human gates</i>"]]
    end

    subgraph know["<b>Knowledge</b>"]
        direction TB
        comp("<b>loop-comprehend</b><br/><i>codebase understanding</i>")
        res("<b>loop-research</b><br/><i>cited research</i>")
        scout("<b>loop-scout</b><br/><i>prior art</i>")
        docs("<b>loop-docs</b><br/><i>documentation</i>")
    end

    subgraph make["<b>Design · build · verify</b>"]
        direction TB
        design("<b>loop-design</b><br/><i>architecture</i>")
        algo("<b>loop-algo</b><br/><i>mechanism</i>")
        fe("<b>loop-frontend</b><br/><i>UI craft</i>")
        pat("<b>loop-pattern</b><br/><i>refactoring</i>")
        rev("<b>loop-review</b><br/><i>security + quality</i>")
        aud("<b>loop-audit</b><br/><i>change impact</i>")
    end

    subgraph run["<b>Integrate · ship · run</b> — the operational cycle"]
        direction LR
        intg("<b>loop-integrate</b><br/><i>platform integration</i>")
        test("<b>loop-test</b><br/><i>tests</i>")
        ship("<b>loop-ship</b><br/><i>release</i>")
        ops("<b>loop-operate</b><br/><i>steady state</i>")
        inc("<b>loop-incident</b><br/><i>live failure</i>")
        dbg("<b>loop-debug</b><br/><i>root cause</i>")
    end

    subgraph autom["<b>Automation</b>"]
        direction TB
        harn("<b>loop-harness</b><br/><i>Claude Code harness</i>")
        auto("<b>loop-autopilot</b><br/><i>autonomous loop</i><br/>draft PRs, never merges")
    end

    %% front door
    guide -- "routes + conducts,<br/>a because-line per pick" --> know
    guide -- "routes" --> make
    guide -- "routes" --> run
    guide -. "escalates a project" .-> build
    guide -. "escalates a product idea" .-> vent

    %% engine & governance
    pol -. "governs" .-> eng
    fw -. "phases + gates" .-> eng
    orch -- "plans the DAG,<br/>routes models" --> eng
    build -- "conducts phases through" --> eng
    vent -- "conducts phases through" --> eng
    vent -- "its build-plan phase<br/>emits the v1 brief" --> build
    ctx -- "typed state between<br/>agents and phases" --> eng
    mk -. "authors against" .-> pol
    mk -- "emits templates for" --> eng
    auto -- "runs the loop on" --> eng
    harn -- "unattended substrate" --> auto

    %% knowledge flows
    comp -- "recovered ADRs" --> design
    comp -- "hands a reproduction" --> dbg
    comp -- "findings become<br/>maintained docs" --> docs
    docs -- "consumes ADR / C4" --> design
    scout -- "delegates search" --> res
    scout -- "hands over a<br/>named provider" --> intg
    fe -- "which library<br/>to adopt at all" --> scout

    %% design & verify flows
    design -- "mechanism inside<br/>a component" --> algo
    design -- "renderer budget vs<br/>curve + duration" --> fe
    rev -- "remediation" --> pat
    aud -- "security dimension" --> rev
    aud -- "risk memo as go/no-go" --> ship

    %% the operational cycle
    intg -- "specifies contract tests" --> test
    test -- "ready to release" --> ship
    ship -- "bake complete —<br/>the service is yours" --> ops
    ops -- "no runbook, or<br/>beyond its scope" --> inc
    inc -- "service restored —<br/>now find the defect" --> dbg
    dbg -- "lock it with<br/>a regression" --> test

    %% shape key: stadium = front door · hexagon = the engine · double-edged = read-only law · rounded = skill
    classDef frontdoor fill:#FDE68A,stroke:#B45309,stroke-width:2px,color:#1C1917
    classDef law fill:#E7E5E4,stroke:#78716C,color:#1C1917
    classDef engine fill:#1D4ED8,stroke:#1E3A8A,stroke-width:2px,color:#FFFFFF
    classDef coreSkill fill:#BFDBFE,stroke:#1D4ED8,color:#0C1B33
    classDef knowSkill fill:#DDD6FE,stroke:#6D28D9,color:#1E1B4B
    classDef makeSkill fill:#BBF7D0,stroke:#15803D,color:#052E16
    classDef runSkill fill:#FECACA,stroke:#B91C1C,color:#450A0A
    classDef autoSkill fill:#99F6E4,stroke:#0F766E,color:#042F2E

    class guide frontdoor
    class pol,fw law
    class eng engine
    class orch,build,vent,ctx,mk coreSkill
    class comp,res,scout,docs knowSkill
    class design,algo,fe,pat,rev,aud makeSkill
    class intg,test,ship,ops,inc,dbg runSkill
    class harn,auto autoSkill

    style core fill:#EFF6FF,stroke:#93C5FD
    style gov fill:#FAFAF9,stroke:#A8A29E,stroke-dasharray:5 5
    style know fill:#F5F3FF,stroke:#C4B5FD
    style make fill:#F0FDF4,stroke:#86EFAC
    style run fill:#FEF2F2,stroke:#FCA5A5
    style autom fill:#F0FDFA,stroke:#5EEAD4
