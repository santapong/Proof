---
title: "4+1 · Execution placement — Proof source, target code and host boundaries"
---
flowchart TB
    subgraph machine["<b>Developer machine</b>"]
        cc["<b>Claude Code</b><br/>Agent session and local tools"]
        mcp["<b>proof-mcp</b><br/>Local Node stdio child process"]
        source["<b>Proof checkout</b><br/>Skills · policy · MCP source · pack builder"]
        target["<b>Target project</b><br/>Its code, tests and Git history"]
    end
    wf["<b>Host-managed Workflow</b><br/>Optional execution environment;<br/>deployment internals are outside Proof"]
    models["<b>Configured provider</b><br/>Account / model availability required"]
    subgraph git["<b>GitHub — optional remote integration</b>"]
        origin["Proof repository<br/>Branches / PRs / source"]
        runner["Actions runner<br/>Node 22; source/package checks"]
    end
    subgraph other["<b>Another host installation — qualify separately</b>"]
        host["Cursor / Codex / Antigravity<br/>22-skill reduced pack"]
        otherMcp["Its own proof-mcp process<br/>When configured and connected"]
        otherSource["Retained complete Proof source<br/>Generated MCP path must resolve"]
    end
    cc -- "stdio JSON-RPC" --> mcp
    mcp -- "reads Proof sources" --> source
    cc -- "reads / authorized edits" --> target
    cc -- "authorized script + args" --> wf
    wf -- "model calls" --> models
    cc -- "inline model calls" --> models
    source -. "authorized push / PR" .-> origin
    origin -- "triggers configured checks" --> runner
    runner -- "checks out a fresh copy" --> source
    source -. "generate and copy pack" .-> host
    host -. "reviewed stdio configuration" .-> otherMcp
    otherMcp -- "reads" --> otherSource
    classDef proc fill:#115E59,stroke:#164E55,color:#fff
    classDef store fill:#D8F1EE,stroke:#0F766E,color:#102F35
    classDef ext fill:#E7E5E4,stroke:#78716C,color:#1C1917
    class cc,mcp,otherMcp proc
    class source,target,otherSource store
    class wf,models,origin,runner,host ext
    style machine fill:#F1F9F7,stroke:#8BC8C1
    style git fill:#F8FAFC,stroke:#94A3B8
    style other fill:#FAFAF9,stroke:#A8A29E,stroke-dasharray:6 4
