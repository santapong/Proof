flowchart TB
    subgraph machine["<b>Developer's machine</b> &nbsp;<i>«deployment node»</i>"]
        direction TB
        ccproc["<b>Claude Code</b><br/><i>«process»</i><br/>Loads skills into context;<br/>runs the Workflow sandbox in-process"]
        mcpproc["<b>heimdall-mcp</b><br/><i>«child process» node server.mjs</i><br/>stdio JSON-RPC, spawned by the host,<br/>dies with the session"]
        files["<b>Repo checkout</b><br/><i>«filesystem»</i><br/>.claude/skills/ · mcp/ · docs/ · dist/"]
    end

    subgraph cloud["<b>Anthropic API</b> &nbsp;<i>«deployment node»</i>"]
        models["<b>Model fleet</b><br/><i>«managed service»</i><br/>Haiku 4.5 · Sonnet 5 · Opus 5 · Fable 5"]
    end

    subgraph gh["<b>GitHub</b> &nbsp;<i>«deployment node»</i>"]
        direction TB
        runner["<b>Actions runner</b><br/><i>«ephemeral container» ubuntu-latest + Node 22</i><br/>validate · smoke · check-host-packs"]
        origin["<b>Origin repo</b><br/><i>«service»</i><br/>Branches, PRs, releases"]
    end

    subgraph other["<b>Another developer's machine</b> &nbsp;<i>«deployment node» — ROADMAP H1/H3/H4</i>"]
        host["<b>Cursor / Codex / Antigravity</b><br/><i>«process»</i><br/>Reads an installed pack;<br/>spawns its own heimdall-mcp"]
    end

    ccproc -- "stdio" --> mcpproc
    ccproc -- "HTTPS — one call per agent node" --> models
    mcpproc -- "reads at boot<br/>and per call" --> files
    ccproc -- "reads and patches" --> files
    files -- "push / PR" --> origin
    origin -- "triggers" --> runner
    runner -- "checks out and gates" --> files
    files -. "pack-host.mjs → copied by hand" .-> host
    host -. "spawns its own<br/>node server.mjs" .-> mcpproc

