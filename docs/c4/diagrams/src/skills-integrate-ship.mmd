---
title: "Skill group — integrate & ship"
---
flowchart TB
    subgraph g["<b>Integrate &amp; ship</b>"]
        intg["<b>proof-integrate</b><br/><i>«component» platform integration</i><br/>Obeys someone else's contract and defends against it:<br/>OAuth/OIDC, webhooks, idempotency, retry"]
        ship["<b>proof-ship</b><br/><i>«component» release</i><br/>Deploy start to bake complete: rollout strategy,<br/>flags, expand-contract migrations, tested rollback"]
    end

    scout["<b>proof-scout</b><br/><i>«external» prior art</i>"]
    test["<b>proof-test</b><br/><i>«external» tests</i>"]
    design["<b>proof-design</b><br/><i>«external» architecture</i>"]
    aud["<b>proof-audit</b><br/><i>«external» change impact</i>"]
    ops["<b>proof-operate</b><br/><i>«external» steady state</i>"]

    scout -- "provider already named —<br/>stop re-litigating the choice" --> intg
    intg -- "specifies the contract;<br/>proof-test authors the files" --> test
    design -- "publishes an API;<br/>proof-integrate consumes one" --> intg
    aud -- "backward-looking memo feeds<br/>the forward-looking gate" --> ship
    ship -- "bake complete —<br/>the service is yours" --> ops

    classDef component fill:#FECACA,stroke:#B91C1C,color:#450A0A
    classDef extc fill:#E7E5E4,stroke:#78716C,color:#1C1917
    class intg,ship component
    class scout,test,design,aud,ops extc
    style g fill:#FEF2F2,stroke:#FCA5A5
